{
  "name": "osai",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @osai/frontend dev",
    "dev:admin": "pnpm --filter @osai/admin dev",
    "dev:api": "pnpm --filter @osai/api dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @osai/frontend build",
    "build:admin": "pnpm --filter @osai/admin build",
    "build:api": "pnpm --filter @osai/api build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:write": "pnpm -r format:write",
    "check": "pnpm -r check",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@8.10.0"
}
