{
  "name": "osai",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @osai/frontend dev",
    "dev:admin": "pnpm --filter @osai/admin dev",
    "dev:api": "pnpm --filter @osai/api dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @osai/shared build && pnpm --filter @osai/frontend build",
    "build:admin": "pnpm --filter @osai/shared build && pnpm --filter @osai/admin build",
    "build:api": "pnpm --filter @osai/shared build && pnpm --filter @osai/api build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:write": "pnpm -r format:write",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "pnpm build:frontend && pnpm build:admin && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "packageManager": "pnpm@8.10.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "0.34.6"
  }
}
